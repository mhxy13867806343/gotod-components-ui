; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited using any text editor.

config_version=5

[application]

config/name="gotod-components-ui"
config/description="Vue-style (Naive UI, Element Plus, AntD, Vant) UI Component Library for Godot 4.x"
config/version="1.0.2"
config/tags=PackedStringArray("ui", "components", "vue", "godot4", "addon")
run/main_scene="res://demo/demo_main.tscn"
config/features=PackedStringArray("4.3", "4.4", "4.6", "Forward Plus")

[autoload]

GMessage="*res://addons/gotod_ui/components/feedback/g_message.gd"
GotodTheme="*res://addons/gotod_ui/theme/gotod_theme.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gotod_ui/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
